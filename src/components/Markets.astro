---
import { markets } from '../data/site';
---
<div class="mk">
  <div class="list">{markets.map((m) => <div class="reveal"><h3>{m.region}</h3><p>{m.list.join(' · ')}</p></div>)}
    <p class="more">…and more — 30+ countries and regions in total.</p></div>
</div>
<style>
.mk{display:block}

.list{display:grid;grid-template-columns:repeat(3,1fr);gap:28px 40px}.list h3{color:#fff;font-size:1.4rem;margin-bottom:6px;padding-bottom:10px;border-bottom:1px solid #ffffff1f}.list p{color:#cdbfae;font-size:.95rem;margin:0}
.more{grid-column:1/-1;color:var(--gold-2)!important;font-style:italic;font-family:var(--serif);font-size:1.2rem!important}
@media(max-width:860px){.list{grid-template-columns:1fr 1fr}}@media(max-width:520px){.list{grid-template-columns:1fr}}
</style>
