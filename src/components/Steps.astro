---
import { oemSteps } from '../data/site';
---
<ol class="steps">{oemSteps.map((s, i) => <li class="reveal" style={`transition-delay:${i * 90}ms`}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
<style>
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:24px;position:relative}
.steps::before{content:'';position:absolute;top:28px;left:28px;right:28px;height:1px;background:linear-gradient(90deg,var(--gold),#b8894d33)}
li{position:relative}.n{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;border:1px solid var(--gold);background:var(--paper);font-family:var(--serif);font-size:1.3rem;color:var(--gold);margin-bottom:24px;position:relative}
.cream .n{background:var(--cream)}h3{font-size:1.35rem;color:var(--coffee);margin-bottom:8px}p{color:var(--muted);font-size:.93rem}
@media(max-width:900px){.steps{grid-template-columns:1fr;gap:0}.steps::before{top:0;bottom:0;left:28px;right:auto;width:1px;height:auto;background:linear-gradient(var(--gold),#b8894d33)}li{padding:0 0 32px 84px}.n{position:absolute;left:0;top:0}}
</style>
