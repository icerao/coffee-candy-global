---
import { c } from '../i18n/content';
import { contact } from '../config';
const mail = `mailto:${contact.email}?subject=${encodeURIComponent(c.contact.subject)}`;
---
<header class="hdr"><div class="wrap row">
  <a href="#top" class="logo">☕ <b>Coffee Candy</b> <small>Authorized Ruiji Food representative</small></a>
  <nav><a href="#products">{c.nav.products}</a><a href="#why">{c.nav.why}</a><a href="#export">{c.nav.export}</a><a href="#faq">{c.nav.faq}</a>
  <a class="btn btn-gd sm" href="#contact">{c.nav.cta}</a></nav>
</div></header>
<main id="top">
<section class="hero"><div class="wrap">
  <p class="eye">{c.hero.eyebrow}</p><h1>{c.hero.title}</h1><p class="lead">{c.hero.sub}</p>
  <div class="ctas"><a class="btn btn-gd" href="#contact">{c.hero.cta1}</a><a class="btn btn-ol" href={mail}>{c.hero.cta2}</a></div>
  <div class="candy" aria-hidden="true"><span></span><span></span><span></span></div>
</div></section>
<div class="stats"><div class="wrap sgrid">{c.stats.map(([n,l]) => <div><b>{n}</b><span>{l}</span></div>)}</div></div>
<section id="products"><div class="wrap"><h2>{c.products.title}</h2><p class="sub">{c.products.sub}</p>
  <div class="grid">{c.products.items.map(([b,n,d]) => <article class="card prod"><div class="ph" aria-hidden="true">☕</div><span class="tag">{b}</span><h3>{n}</h3><p>{d}</p></article>)}</div>
  <p class="note">{c.products.note}</p></div></section>
<section id="why" class="alt"><div class="wrap"><h2>{c.why.title}</h2><p class="sub"></p>
  <div class="grid">{c.why.items.map(([h,p]) => <div class="card"><h3>✔ {h}</h3><p>{p}</p></div>)}</div></div></section>
<section id="export"><div class="wrap"><h2>{c.export.title}</h2><p class="sub"></p>
  <div class="grid">{c.export.items.map(([h,p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}</div>
  <p class="moq">{c.export.moq} <a href="#contact">→</a></p></div></section>
<section id="faq" class="alt"><div class="wrap narrow"><h2>{c.faq.title}</h2><p class="sub"></p>
  {c.faq.items.map(([q,a]) => <details class="card"><summary>{q}</summary><p>{a}</p></details>)}</div></section>
<section id="contact" class="ct"><div class="wrap cgrid">
  <div><h2>{c.contact.title}</h2><p>{c.contact.sub}</p>
    <ul class="links">
      <li>{c.contact.person}: <b>{c.contact.rep}</b></li>
      <li><a class="btn btn-gd" href={mail}>✉️ {contact.email}</a></li>
    </ul>
  </div>
  <form id="inq" class="card" data-endpoint={contact.formEndpoint} data-key={contact.web3formsKey} data-email={contact.email} data-subject={c.contact.subject} data-ok={c.contact.ok} data-err={c.contact.err} data-sending={c.contact.sending}>
    <div class="two"><label>{c.contact.name}*<input name="name" required /></label><label>{c.contact.company}<input name="company" /></label></div>
    <div class="two"><label>{c.contact.email}*<input type="email" name="email" required /></label><label>{c.contact.country}*<input name="country" required /></label></div>
    <label>{c.contact.qty}<input name="quantity" /></label>
    <label>{c.contact.msg}*<textarea name="message" rows="4" required></textarea></label>
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
    <button class="btn btn-gd" type="submit">{c.contact.send}</button><p class="status" role="status"></p>
  </form>
</div></section>
</main>
<footer><div class="wrap">© {new Date().getFullYear()} · {c.footer}</div></footer>
<script>
const f = document.getElementById('inq') as HTMLFormElement;
f.addEventListener('submit', async (e) => {
  e.preventDefault();
  const d = f.dataset, s = f.querySelector('.status') as HTMLElement, fd = new FormData(f);
  if (fd.get('botcheck')) return;
  fd.delete('botcheck');
  const mailto = () => {
    const body = [...fd.entries()].map(([k, v]) => `${k}: ${v}`).join('\n');
    location.href = `mailto:${d.email}?subject=${encodeURIComponent(`${d.subject} - ${fd.get('company') || fd.get('name')}`)}&body=${encodeURIComponent(body)}`;
  };
  if (!d.endpoint) return mailto();
  s.textContent = d.sending!;
  try {
    if (d.key) fd.append('access_key', d.key);
    fd.append('subject', d.subject!);
    const r = await fetch(d.endpoint, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
    if (!r.ok) throw 0;
    s.textContent = d.ok!; f.reset();
  } catch { s.textContent = d.err!; mailto(); }
});
</script>
<style>
.hdr{position:sticky;top:0;z-index:10;background:#2a180df2;color:#fff;backdrop-filter:blur(6px)}.row{display:flex;align-items:center;justify-content:space-between;height:64px}.logo{text-decoration:none;font-size:1.1rem}.logo small{opacity:.7}
nav{display:flex;gap:18px;align-items:center}nav a{text-decoration:none;opacity:.9}.sm{padding:8px 16px}
.hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(circle at 80% 30%,#7a4a2a,transparent 50%),linear-gradient(135deg,#2a180d,#4a2c1a);padding:110px 0 120px}
.hero h1{font-size:clamp(2.2rem,5.5vw,4rem);line-height:1.1;margin:8px 0 18px;max-width:700px}.eye{color:var(--gd);font-weight:600;letter-spacing:.05em}.lead{max-width:620px;font-size:1.15rem;opacity:.9}.ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
.candy span{position:absolute;width:150px;height:100px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e0ad78,#8a5430 60%,#4a2c1a);box-shadow:0 20px 40px #0006;right:8%;top:22%;transform:rotate(-25deg)}.candy span:nth-child(2){right:22%;top:55%;width:110px;height:72px;transform:rotate(20deg)}.candy span:nth-child(3){right:4%;top:62%;width:90px;height:60px;transform:rotate(60deg)}
.stats{background:var(--gd);color:#fff}.sgrid{display:grid;grid-template-columns:repeat(6,1fr);padding:26px 20px;text-align:center}.sgrid b{display:block;font-size:1.6rem}.sgrid span{font-size:.85rem;opacity:.95}
.alt{background:var(--cr)}.prod .ph{height:120px;border-radius:12px;background:linear-gradient(135deg,#6b3f22,#c8915a);display:grid;place-items:center;font-size:3rem;margin-bottom:14px}.tag{font-size:.75rem;background:#f1e2cf;color:var(--br);padding:3px 10px;border-radius:999px;font-weight:600}
.note{font-size:.8rem;color:#8a7766;margin-top:18px}.moq{margin-top:24px;font-weight:600;color:var(--br)}.narrow{max-width:800px}details{margin-bottom:12px;padding:18px 22px}summary{font-weight:600;cursor:pointer;color:var(--br)}
.ct{background:linear-gradient(135deg,#2a180d,#4a2c1a);color:#fff}.ct h2{color:#fff}.cgrid{display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:start}.links{list-style:none;padding:0;display:grid;gap:14px}
form.card{color:var(--tx);display:grid;gap:12px}label{display:grid;gap:4px;font-size:.88rem;font-weight:600}input,textarea{font:inherit;padding:10px 12px;border:1px solid #d9c8b4;border-radius:10px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hp{display:none}.status{margin:0;font-size:.9rem}
footer{background:#1a0f08;color:#cdb9a5;padding:24px 0;font-size:.85rem}
@media(max-width:860px){nav a:not(.btn){display:none}.sgrid{grid-template-columns:repeat(3,1fr);gap:14px}.cgrid,.two{grid-template-columns:1fr}.candy{display:none}.hero{padding:70px 0 80px}.logo small{display:none}}
</style>
