---
import { certs } from '../data/site';
---
<div class="certs" aria-label="Manufacturer certifications"><div class="wrap row">
  <span class="lbl">Manufacturer certifications</span>
  <ul>{certs.map((c) => <li>{c}</li>)}</ul>
</div></div>
<style>
.certs{border-block:1px solid var(--line);background:#fff}.row{display:flex;align-items:center;gap:40px;padding-block:26px;flex-wrap:wrap}
.lbl{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:600}
ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px 36px;flex:1;justify-content:space-between}
li{font-family:var(--serif);font-size:1.45rem;color:var(--coffee);display:flex;align-items:center;gap:10px}li::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold)}
</style>
