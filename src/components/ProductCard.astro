---
import type { Product } from '../data/site';
interface Props { p: Product }
const { p } = Astro.props;
---
<article class="pc reveal">
  <div class="art"><img src={`/images/${p.img}.webp`} alt={`${p.brand} ${p.name} packaging`} loading="lazy" decoding="async" width="600" height="600" /></div>
  <div class="body"><span class="brand">{p.brand}</span><h3>{p.name}</h3><span class="cn" lang="zh">{p.cn}</span><p>{p.desc}</p>
    <ul>{p.badges.map((b) => <li>{b}</li>)}</ul></div>
</article>
<style>
.pc{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .35s,box-shadow .35s,border-color .35s;display:flex;flex-direction:column}
.pc:hover{transform:translateY(-6px);box-shadow:0 24px 48px -24px #3a241640;border-color:var(--gold-2)}
.art{aspect-ratio:1;overflow:hidden;background:var(--cream)}.art img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.pc:hover img{transform:scale(1.05)}
.body{padding:24px 24px 28px;flex:1}.brand{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:600}
h3{margin:8px 0 2px;color:var(--coffee)}.cn{display:block;font-size:.8rem;color:#a8998a;margin-bottom:10px}p{color:var(--muted);font-size:.93rem}
ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}li{font-size:.74rem;border:1px solid var(--line);padding:4px 10px;border-radius:999px;color:var(--coffee-2)}
</style>
