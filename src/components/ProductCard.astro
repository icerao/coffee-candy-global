---
import Candy from './Candy.astro';
interface Props { p: { brand: string; name: string; desc: string; tone: string; badges: string[] } }
const { p } = Astro.props;
---
<article class="pc reveal">
  <div class={`art t-${p.tone}`}><Candy tone={p.tone as any} label={`Illustration: ${p.name}`} /></div>
  <div class="body"><span class="brand">{p.brand}</span><h3>{p.name}</h3><p>{p.desc}</p>
    <ul>{p.badges.map((b) => <li>{b}</li>)}</ul></div>
</article>
<style>
.pc{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .35s,box-shadow .35s,border-color .35s;display:flex;flex-direction:column}
.pc:hover{transform:translateY(-6px);box-shadow:0 24px 48px -24px #3a241640;border-color:var(--gold-2)}
.art{aspect-ratio:4/3;display:grid;place-items:center;padding:28px;background:radial-gradient(circle at 50% 60%,#fff 0,var(--cream) 70%)}.t-black,.t-dark{background:radial-gradient(circle at 50% 60%,#f9f2e7,#eadbc5 75%)}
.art :global(svg){width:88%;transition:transform .6s}.pc:hover .art :global(svg){transform:rotate(-6deg) scale(1.05)}
.body{padding:26px 26px 30px;flex:1}.brand{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:600}
h3{margin:8px 0 10px;color:var(--coffee)}p{color:var(--muted);font-size:.95rem}
ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}li{font-size:.74rem;border:1px solid var(--line);padding:4px 10px;border-radius:999px;color:var(--coffee-2)}
</style>
