---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CertStrip from '../components/CertStrip.astro';
import Stats from '../components/Stats.astro';
import ProductCard from '../components/ProductCard.astro';
import Steps from '../components/Steps.astro';
import Markets from '../components/Markets.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { products, strengths, claimNote } from '../data/site';
const icons = ['shield', 'factory', 'leaf', 'globe'] as const;
---
<Base title="Sugar-Free Coffee Candy Wholesale & OEM" description="Source sugar-free coffee candy direct from Ruiji Food Group, China, via its authorized export representative. ISO 22000, HACCP, FDA, BRC, HALAL certified; 30,000 t annual capacity; exported to 30+ countries.">
<section class="hero">
  <div class="wrap hg">
    <div class="copy">
      <span class="eyebrow">Authorized export representative · Ruiji Food Group</span>
      <h1>Sugar-free coffee candy, <em>crafted at scale</em> for the world.</h1>
      <p>Wholesale, distribution and private-label supply of X-it and I'MINT coffee candy — direct from one of China's pioneers in large-scale sugar-free confectionery.</p>
      <div class="acts"><a class="btn btn-gold" href="/contact/">Request a quote <Icon name="arrow" /></a><a class="btn btn-line" href="/products/">View products</a></div>
      <dl class="mini"><div><dt>Founded</dt><dd>2014</dd></div><div><dt>Exported to</dt><dd>30+ countries</dd></div><div><dt>Capacity</dt><dd>30,000 t / yr</dd></div></dl>
    </div>
    <div class="art"><figure class="f1"><img src="/images/xit-vc-black-coffee-candy.webp" alt="X-it VC Black Coffee Candy tins on coffee beans" width="398" height="421" fetchpriority="high" /></figure><figure class="f2"><img src="/images/xit-iced-coffee-candy.webp" alt="X-it Iced Coffee Candy Premium BonBons tin" width="508" height="403" /><figcaption>X-it Iced Coffee Candy · No.1 online sales nationwide*</figcaption></figure></div>
  </div>
</section>
<CertStrip />
<section class="section"><div class="wrap">
  <div class="split">
    <div class="head reveal"><span class="eyebrow">Why source with us</span><h2>A certified manufacturer, one dedicated point of contact.</h2>
      <p>Ruiji Food Group was founded in 2014 in Zhongshan, Guangdong, and focuses entirely on sugar-free confectionery. As its authorized export representative, icerao gives international buyers a direct line to the factory.</p>
      <a class="link" href="/about/">About the manufacturer</a></div>
    <div class="grid g2">{strengths.map((s, i) => <div class="feat reveal"><span class="ic"><Icon name={icons[i]} /></span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
  </div>
</div></section>
<section class="section dark"><div class="wrap"><div class="head center reveal"><span class="eyebrow">Ruiji Food Group in numbers</span><h2>Scale you can build a supply programme on.</h2></div><Stats /></div></section>
<section class="section cream"><div class="wrap fb">
  <div class="reveal"><span class="eyebrow">Inside the factory</span><h2>Class 100,000 GMP cleanrooms.</h2><p class="mut">Automated production lines at the Zhongshan Torch Zone headquarters, opened in 2025, integrate intelligent manufacturing, a digital R&D center and a supply-chain hub.</p><a class="link" href="/about/#factory">See the factory</a></div>
  <div class="ph2"><img class="reveal" src="/images/factory-line-1.webp" alt="Production line in the GMP cleanroom" loading="lazy" width="545" height="398" /><img class="reveal" src="/images/factory-line-2.webp" alt="Automated packing line with operators in cleanroom suits" loading="lazy" width="573" height="398" /></div>
</div></section>
<section class="section"><div class="wrap">
  <div class="hrow"><div class="head reveal"><span class="eyebrow">Coffee candy range</span><h2>Signature sugar-free coffee candy</h2></div><a class="link" href="/products/">All products</a></div>
  <div class="grid g4">{products.filter((p) => p.featured).map((p) => <ProductCard p={p} />)}</div><p class="fn">{claimNote}</p>
</div></section>
<section class="section cream"><div class="wrap"><div class="head reveal"><span class="eyebrow">OEM & private label</span><h2>From first inquiry to export delivery.</h2></div><Steps /><p class="more"><a class="link" href="/oem/">OEM & export details</a></p></div></section>
<section class="section dark"><div class="wrap"><div class="head reveal"><span class="eyebrow">Export markets</span><h2>Supplying buyers across Asia, Europe, the Americas, Oceania and the Middle East.</h2></div><Markets /></div></section>
<section class="section"><div class="wrap faqw"><div class="head reveal"><span class="eyebrow">FAQ</span><h2>Frequently asked questions</h2></div><Faq /></div></section>
<Cta />
</Base>
<style>
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:center;color:#fff;overflow:hidden;background:radial-gradient(ellipse at 75% 45%,#5a3a24 0,transparent 55%),linear-gradient(160deg,#2c1b10,#160d07);padding:140px 0 90px}
.hero::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,#ffffff05 0 1px,transparent 1px 120px)}
.hg{display:grid;grid-template-columns:1.15fr 1fr;gap:40px;align-items:center;position:relative}
.hero h1 em{font-style:italic;color:var(--gold-2)}.copy>p{font-size:1.15rem;color:#d6c8b7;max-width:560px;margin:28px 0 40px}.acts{display:flex;gap:16px;flex-wrap:wrap}
.mini{display:flex;gap:48px;margin:64px 0 0;padding-top:28px;border-top:1px solid #ffffff1f;flex-wrap:wrap}.mini dt{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:#a8998a}.mini dd{margin:6px 0 0;font-family:var(--serif);font-size:1.6rem}
.art{position:relative;aspect-ratio:1;max-width:540px;justify-self:end;width:100%}.art figure{margin:0;position:absolute;overflow:hidden;border-radius:var(--r);box-shadow:0 40px 80px -30px #000c}.art img{width:100%;height:100%;object-fit:cover}.f1{inset:0 18% 16% 0;border:1px solid #d8b37a55}.f2{width:54%;right:0;bottom:0;background:#fff;border:6px solid #fff}.f2 img{aspect-ratio:5/4}.f2 figcaption{font-size:.7rem;color:var(--coffee);padding:8px 4px 2px;letter-spacing:.04em}
@media(max-width:960px){.hg{grid-template-columns:1fr}.art{max-width:440px;margin:0 auto;justify-self:center}.hero{padding-top:120px}.mini{gap:28px;margin-top:44px}}
.split{display:grid;grid-template-columns:1fr 1.3fr;gap:72px;align-items:start}.split .head{position:sticky;top:120px}@media(max-width:960px){.split{grid-template-columns:1fr;gap:16px}.split .head{position:static}}
.feat{padding:32px;background:#fff;border:1px solid var(--line);border-radius:var(--r);transition:border-color .3s,transform .3s}.feat:hover{border-color:var(--gold-2);transform:translateY(-4px)}
.ic{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--cream);color:var(--gold);margin-bottom:22px}.ic :global(svg){width:24px}.feat h3{color:var(--coffee);margin-bottom:10px}.feat p{color:var(--muted);font-size:.95rem;margin:0}
.hrow{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap}.hrow .link{margin-bottom:56px}.fn{font-size:.8rem;color:var(--muted);margin-top:28px}.more{margin-top:40px}.faqw{max-width:920px}.fb{display:grid;grid-template-columns:1fr 1.5fr;gap:64px;align-items:center}.mut{color:var(--muted);margin:18px 0 26px}.ph2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.ph2 img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--r)}@media(max-width:860px){.fb{grid-template-columns:1fr;gap:32px}}
</style>
