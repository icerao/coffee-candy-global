---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import CertStrip from '../components/CertStrip.astro';
import Cta from '../components/Cta.astro';
import { milestones, experts } from '../data/site';
const sub = [['#overview', 'Overview'], ['#factory', 'Factory'], ['#quality', 'Quality'], ['#rnd', 'R&D'], ['#history', 'Milestones']];
const awards = ['High-Tech Enterprise (Guangdong & Henan)', 'China National Confectionery Association member', 'Guangdong Famous Food Brand product', 'X-it trademark registered with EUIPO', '2025 New York, France, London & MUSE packaging-design awards', 'Alibaba.com three-star verified supplier', 'Intertek verified supplier certificate', 'Annual audits by international companies such as Disney'];
---
<Base title="About the Manufacturer" description="Ruiji Food Group: founded 2014 in Zhongshan, China. Class 100,000 GMP cleanrooms, 30,000 t capacity, ISO 22000, HACCP, FDA, BRC and HALAL certified.">
<PageHero eyebrow="The manufacturer" title="Ruiji Food Group" lead="Founded in 2014 and headquartered in the Torch Development Zone, Zhongshan, Guangdong — a pioneer and leader in China's sugar-free confectionery industry." />
<nav class="subnav" aria-label="On this page"><div class="wrap">{sub.map(([h, l]) => <a href={h}>{l}</a>)}</div></nav>
<section class="section" id="overview"><div class="wrap two reveal">
  <div><span class="eyebrow">Overview</span><h2>Nourishing a happier future with health and great taste.</h2></div>
  <div class="txt"><p>Ruiji Food Group pioneered large-scale production of sugar-free candy in China. Its brands — I'MINT, X-it, Rejee and KISS PEARL — offer 200+ products sold through e-commerce, offline retail, OEM and export channels.</p><p>Products reach 500,000+ retail outlets in China through 1,000+ distribution partners, and are exported to 30+ countries and regions. In 2025, group sales exceeded RMB 1.3 billion.</p></div>
</div></section>
<section class="section dark" id="factory"><div class="wrap"><div class="head reveal"><span class="eyebrow">Smart manufacturing</span><h2>Factory & supply chain</h2><p>A self-built supply chain, proprietary core processes, automated production and Class 100,000 GMP cleanrooms, supported by a digital R&D laboratory.</p></div><Stats />
  <div class="grid g3 fac">{[['Zhongshan Torch Zone HQ', 'Opened 2025 — intelligent production lines, digital R&D center and supply-chain hub.'], ['Meixinlong packaging factory', 'In-house packaging production within the group.'], ['Nanyang plant', 'Additional production base.']].map(([t, d]) => <div class="reveal"><h3>{t}</h3><p>{d}</p></div>)}</div>
</div></section>
<CertStrip />
<section class="section" id="quality"><div class="wrap two">
  <div class="reveal"><span class="eyebrow">Quality & credentials</span><h2>Internationally recognised quality systems.</h2></div>
  <ul class="aw">{awards.map((a) => <li class="reveal">{a}</li>)}</ul>
</div></section>
<section class="section cream" id="rnd"><div class="wrap"><div class="head reveal"><span class="eyebrow">Research & development</span><h2>Led by experienced confectionery scientists.</h2></div>
  <div class="grid g3">{experts.map((e) => <div class="ex reveal"><span class="mono" aria-hidden="true">{e.n.replace('Dr. ', '').split(' ').map((w) => w[0]).join('')}</span><h3>{e.n}</h3><span class="role">{e.r}</span><p>{e.d}</p></div>)}</div></div></section>
<section class="section" id="history"><div class="wrap"><div class="head reveal"><span class="eyebrow">Milestones</span><h2>A decade of sugar-free growth.</h2></div>
  <ol class="tl">{milestones.map(([y, t]) => <li class="reveal"><b>{y}</b><p>{t}</p></li>)}</ol></div></section>
<Cta />
</Base>
<style>
.subnav{position:sticky;top:76px;z-index:30;background:#fffffff2;backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}.subnav .wrap{display:flex;gap:36px;overflow-x:auto}
.subnav a{flex:none;text-decoration:none;font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:18px 0;border-bottom:2px solid transparent;transition:.2s}.subnav a:hover,.subnav :global(a.on){color:var(--coffee);border-color:var(--gold)}
section[id]{scroll-margin-top:140px}
.two{display:grid;grid-template-columns:1fr 1.1fr;gap:72px}.txt p{color:var(--muted);font-size:1.08rem}@media(max-width:860px){.two{grid-template-columns:1fr;gap:24px}}
.fac{margin-top:56px}.fac h3{color:#fff;margin-bottom:8px;padding-top:20px;border-top:1px solid var(--gold)}.fac p{color:#cdbfae}
.aw{list-style:none;margin:0;padding:0}.aw li{padding:18px 0 18px 36px;border-bottom:1px solid var(--line);position:relative;font-size:1.02rem}.aw li::before{content:'';position:absolute;left:4px;top:27px;width:14px;height:1px;background:var(--gold)}
.ex{background:#fff;padding:36px;border:1px solid var(--line);border-radius:var(--r)}.mono{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:var(--coffee);color:var(--gold-2);font-family:var(--serif);font-size:1.4rem;margin-bottom:22px}
.ex h3{color:var(--coffee)}.role{display:block;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:6px 0 14px;font-weight:600}.ex p{color:var(--muted);font-size:.95rem;margin:0}
.tl{list-style:none;margin:0;padding:0;border-left:1px solid var(--gold);margin-left:10px}.tl li{position:relative;padding:0 0 36px 40px;display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:baseline}
.tl li::before{content:'';position:absolute;left:-6px;top:12px;width:11px;height:11px;border-radius:50%;background:var(--paper);border:2px solid var(--gold)}.tl b{font-family:var(--serif);font-size:2rem;font-weight:500;color:var(--coffee)}.tl p{color:var(--muted);margin:0}
@media(max-width:640px){.tl li{grid-template-columns:1fr;gap:4px}}
</style>
